<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/android_window_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_surface"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/button_history_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:minHeight="44dp"
                android:text="@string/history_tab"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/button_preferences_tab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_idle"
                android:minHeight="44dp"
                android:text="@string/preferences_tab"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/history_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_section_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinner_history_scope"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="0.34"
                    android:background="@drawable/bg_search_field"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:minWidth="112dp" />

                <EditText
                    android:id="@+id/input_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.66"
                    android:background="@drawable/bg_search_field"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_clear"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_history_content_description"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:tint="@color/color_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/preferences_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_name" />

                <EditText
                    android:id="@+id/input_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:inputType="textPersonName" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/history_limit" />

                <EditText
                    android:id="@+id/input_history_limit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:inputType="number" />

                <Switch
                    android:id="@+id/switch_share_local_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/share_local_history" />

                <Switch
                    android:id="@+id/switch_prefer_remote_latest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/prefer_remote_latest" />

                <Switch
                    android:id="@+id/switch_discovery_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/discovery_enabled" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/online_devices" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_search_field"
                    android:clipToPadding="false"
                    android:maxHeight="240dp"
                    android:nestedScrollingEnabled="false"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/text_devices_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_search_field"
                    android:padding="12dp"
                    android:text="@string/no_devices_yet"
                    android:textColor="@color/color_text_secondary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/button_save_preferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/color_action_primary"
                    android:minHeight="46dp"
                    android:text="@string/save_preferences"
                    android:textAllCaps="false" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/transfer_overlay_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/transfer_popup_card"
            android:layout_width="324dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_transfer_panel"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/transfer_current_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_transfer_popup_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="@color/color_text_primary" />

                <TextView
                    android:id="@+id/text_transfer_popup_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/color_text_secondary" />

                <ProgressBar
                    android:id="@+id/progress_transfer_popup"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0" />

                <TextView
                    android:id="@+id/text_transfer_popup_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/color_text_secondary" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_transfer_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxHeight="220dp"
                android:nestedScrollingEnabled="true"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_transfer_fab"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_transfer_fab"
            android:clickable="true"
            android:contentDescription="@string/history_transfer_button_content_description"
            android:elevation="6dp"
            android:focusable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/stat_sys_download_done"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
